# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# O .env.local é ignorado pelo git e nunca deve ser comitado.
#
# Onde achar: Dashboard do Supabase → Settings → API
#
# Estas duas chaves são seguras no front-end: o navegador precisa delas para
# falar com o banco, e a proteção real vem das policies de RLS.
#
# NUNCA coloque aqui a service_role key — ela ignora todas as regras de RLS e
# só deve existir em servidor.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key
